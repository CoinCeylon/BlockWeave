# Copy to app/.env.local and fill in. NEVER commit the real file.

# ---- Data source ----
# "mock"  = fake data, no wallet needed (Person C works with this until 1 Dec)
# "chain" = real Cardano Preprod + Midnight Preprod
NEXT_PUBLIC_DATA_SOURCE=mock

# ---- Cardano (Person A) ----
NEXT_PUBLIC_CARDANO_NETWORK=preprod
# Blockfrost project id (Preprod). Free tier: https://blockfrost.io/
BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXXXXXXXXXXXXX
# Filled in after `aiken build` + address derivation
NEXT_PUBLIC_LOT_POLICY_ID=
NEXT_PUBLIC_LOT_TRACKER_ADDRESS=

# ---- Midnight (Person B) ----
NEXT_PUBLIC_MIDNIGHT_NETWORK=preprod
NEXT_PUBLIC_AUCTION_CONTRACT_ADDRESS=
# Local proof server (started via Docker, see contracts/midnight/README.md)
NEXT_PUBLIC_PROOF_SERVER_URL=http://localhost:6300
