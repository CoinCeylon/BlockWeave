# Copy to contracts/midnight/.env (git-ignored) and fill in.
# Midnight Preprod project key from blockfrost.io (starts with nightpreprod).
# NOT the Cardano Preprod key.
BLOCKFROST_PROJECT_ID=

# Created automatically by `npm run wallet` on first run. Don't share them.
# MIDNIGHT_SEED=
# MIDNIGHT_PRIVATE_STATE_PASSWORD=

# Optional
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
# MIDNIGHT_MIN_DUST=60
